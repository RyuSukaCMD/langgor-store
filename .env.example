# ─────────────────────────────────────────────────────────────────────────────
# Langgor Store environment
# Copy this file to .env. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Application — domain/protocol/cookies are detected automatically.
NODE_ENV=development
PORT=5173
LOG_LEVEL=info

# Supabase — Project Settings > API
# The anon key may be used in a browser only when RLS policies are enabled.
# The service-role key must remain server-only and must never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=langgor-media

# PostgreSQL — Project Settings > Database
# DATABASE_URL uses the transaction pooler in serverless deployments.
# DIRECT_URL is for migrations and other direct database operations.
DATABASE_URL=
DIRECT_URL=

# Rate limiting
# Use RATE_LIMIT_STORE=redis for multi-instance/serverless production.
RATE_LIMIT_STORE=memory
REDIS_URL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=30

# Uploads
PROFILE_UPLOAD_MAX_BYTES=5242880
IMAGE_MAX_DIMENSION=6000
IMAGE_MIN_DIMENSION=128
BANNER_MIN_ASPECT_RATIO=2.5

# Data encryption / secure delivery
# Use a KMS in production; this local key is only an application-level fallback.
# Generate with: openssl rand -base64 32
DELIVERY_ENCRYPTION_KEY=
KMS_KEY_ID=
KMS_REGION=ap-southeast-1

# Payment provider — configure only the provider being used
PAYMENT_PROVIDER=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Transaction behavior
ORDER_EXPIRY_MINUTES=60
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Langgor Store <no-reply@langgor.store>
SUPPORT_EMAIL=halo@langgor.store

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional; when empty the backend derives the audit hash key from the service-role key.
AUDIT_IP_HASH_SECRET=

# Optional bootstrap. Remove after the first admin is provisioned.
BOOTSTRAP_ADMIN_EMAIL=
